# BoardMaster — environment configuration
#
# Copy to `.env` and fill in the values you need. `.env` is gitignored; this
# file is the committed template and must never contain a real secret.
#
# Every one of these is OPTIONAL. With none of them set the lab still runs in
# full: the circuit analyser, the Arduino/ESP32 interpreter and the PCB checks
# are all deterministic and local. Only the Claude tutor, real SPICE and the
# ElevenLabs voice are gated behind keys, and each degrades to a clearly
# labelled fallback rather than failing or pretending.

# ---------------------------------------------------------------------------
# AI tutor (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------
# Without this the tutor runs as "Local Demo Tutor": deterministic, rule-based
# explanations derived from the same evidence, labelled as such in the UI.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model id for the tutor. Default: claude-sonnet-5-5
BOARDMASTER_TUTOR_MODEL=claude-sonnet-5-5

# Max output tokens for a tutor reply, 256..8192. Default: 1400
BOARDMASTER_MAX_TOKENS=1400

# ---------------------------------------------------------------------------
# SPICE (optional)
# ---------------------------------------------------------------------------
# Absolute path to an ngspice binary. Unset, the lab uses only its own
# deterministic DC engine and says so — it never presents a simplified result
# as a SPICE result.
# NGSPICE_PATH=/usr/bin/ngspice

# ---------------------------------------------------------------------------
# Voice (optional)
# ---------------------------------------------------------------------------
# Unset, spoken feedback falls back to the browser's built-in Web Speech API.
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_VOICE_ID=your-voice-id
# ELEVENLABS_MODEL=eleven_turbo_v2_5
